# ----- Homebrew (macOS)
{{ if eq .os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
BREW_PREFIX="$(/opt/homebrew/bin/brew --prefix)"
{{- end }}

# ----- PATH
export PATH="$HOME/.local/bin:$PATH"

# Pro tip: Run 'dx' for a cheatsheet of all your tools!

# ----- Completions
autoload -Uz compinit && compinit

# ----- History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt INC_APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS

# ----- fzf keybindings and colors (if installed)
if [[ -n "$BREW_PREFIX" ]]; then
  FZF_BIND="$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
  [ -f "$FZF_BIND" ] && source "$FZF_BIND"

  # Catppuccin Mocha colors for fzf
  export FZF_DEFAULT_OPTS=" \
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
fi

# ----- Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# ----- Modern CLI replacements
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --git --group-directories-first'
  alias ll='eza -lah --icons --git --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
else
  alias l='ls -lah'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --style=auto --paging=never'
  alias less='bat --style=auto'
fi

# ----- Git aliases
alias gs='git status'
alias gc='git commit'
alias gp='git push'
alias lg='lazygit'

# ----- General aliases
alias v='nvim'
alias ..='cd ..'
alias ...='cd ../..'

# ----- Custom Aliases
alias letsbanj="sh $HOME/Documents/repos/banja-claude/run.sh"
alias kclean='kubectl get pods -A --no-headers | gawk '\''$4=="Evicted" || $4=="Completed" || $4=="Error" || $4=="CrashLoopBackOff" || $4=="ContainerStatusUnknown" || $4=="Init:Error" || $4=="Init:CrashLoopBackOff" || $4=="ImagePullBackOff" || $4=="ErrImagePull" || $4=="CreateContainerError" || $4=="InvalidImageName" {print "kubectl delete pod -n " $1 " " $2}'\'' | sh'

# ----- Kubernetes aliases
alias k='kubectl'
alias kx='kubectx'
alias kn='kubens'
alias logs='stern'

# ----- Docker aliases
alias dps='docker ps --format "table {{`{{.Names}}`}}\t{{`{{.Status}}`}}\t{{`{{.Ports}}`}}"'
alias dlog='docker logs -f'

# ----- Editor
export EDITOR="nvim"
export VISUAL="nvim"

# ----- nvm (lazy-loaded for faster shell startup)
export NVM_DIR="$([[ -z "${XDG_CONFIG_HOME-}" ]] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"

_load_nvm() {
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
}

# Stub commands that trigger nvm loading on first use
for cmd in nvm node npm npx; do
  eval "${cmd}() { unfunction nvm node npm npx 2>/dev/null; _load_nvm; ${cmd} \"\$@\" }"
done

# Auto-switch Node version based on .nvmrc
autoload -U add-zsh-hook
load-nvmrc() {
  local nvmrc_path
  nvmrc_path="$(nvm_find_nvmrc 2>/dev/null)"

  if [ -n "$nvmrc_path" ]; then
    # nvm is needed — ensure it's loaded
    if ! command -v nvm >/dev/null 2>&1 || ! typeset -f nvm >/dev/null 2>&1; then
      unfunction nvm node npm npx 2>/dev/null
      _load_nvm
    fi

    local node_version="$(nvm version)"
    local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$node_version" ]; then
      nvm use
    fi
  fi
}
add-zsh-hook chpwd load-nvmrc
load-nvmrc

# ----- direnv
eval "$(direnv hook zsh)"

# ----- zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias cd='z'
fi

# ----- zsh-autosuggestions
if [[ -n "$BREW_PREFIX" ]] && [ -f "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# ----- zsh-syntax-highlighting (must be last)
if [[ -n "$BREW_PREFIX" ]] && [ -f "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ----- bun
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# ----- Kubernetes
export KUBECONFIG="$HOME/.kube/config:$(printf "%s:" $HOME/.kube/configs/*.yaml 2>/dev/null | sed 's/:$//')"

# ----- mise (Java, Python, etc. - Node uses nvm)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# ----- Tailscale CLI
if [ -d "/Applications/Tailscale.app" ]; then
  export PATH="/Applications/Tailscale.app/Contents/MacOS:$PATH"
fi

# ----- Android SDK (React Native)
if [ -d "$HOME/Library/Android/sdk" ]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export PATH="$PATH:$ANDROID_HOME/emulator"
  export PATH="$PATH:$ANDROID_HOME/platform-tools"
fi
